{
  "type": "module",
  "name": "sistema-pos",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w apps/backend && npm run build:web -w apps/desktop",
    "backend:dev": "npm run dev -w apps/backend",
    "desktop:dev": "npm run dev -w apps/desktop",
    "backend:migrate": "npm run migrate -w apps/backend"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "usb": "^3.1.0"
  }
}
